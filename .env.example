# Optional overrides for `docker compose up`. Copy to .env and edit.
# Compose reads .env from this directory automatically.

# Signing key for the API. Generate one for anything beyond a local run, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# exact-match (server marks answers) or client-reported (trust the caller).
QUIZ_SCORING_STRATEGY=exact-match

DJANGO_LOG_LEVEL=INFO
