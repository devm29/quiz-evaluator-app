# Environment for running the API outside Docker. Django reads the process
# environment only, so export these (or use a tool such as direnv); nothing
# loads this file automatically. Every value has a safe default.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8220,http://127.0.0.1:8220
# DJANGO_SQLITE_PATH=/absolute/path/to/db.sqlite3
QUIZ_SCORING_STRATEGY=exact-match
QUIZ_MAX_QUESTIONS_PER_SUBMISSION=100
QUIZ_ANON_THROTTLE_RATE=60/min
